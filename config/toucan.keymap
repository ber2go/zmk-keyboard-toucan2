#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>; };

&lt {
    flavor = "balanced";
    quick-tap-ms = <150>;
    tapping-term-ms = <200>;
};

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <6 7 8 9 10 18 19 21 22 30 31 32 33 34 39 40 41 20>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            require-prior-idle-ms = <125>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <1 2 3 4 5 13 14 15 16 17 25 26 27 28 29 36 37 38>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_caps {
            bindings = <&caps_word>;
            key-positions = <17 18>;
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &none  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Y  &kp U  &kp I  &kp O  &kp P  &none
                &none  &hml LGUI A  &hml LALT S  &hml LCTRL D  &hml LSHIFT F  &kp G  &kp H  &hmr RSHIFT J  &hmr RCTRL K  &hmr LALT L  &hmr LGUI SQT  &none
                &none  &mt LS(LA(LC(LGUI))) Z  &mt LS(LC(LALT)) X  &kp C  &kp V  &kp B  &kp N  &kp M  &kp COMMA  &kp DOT  &kp SLASH  &none
                          &lt 0 ESC  &lt 1 SPACE  &lt 5 TAB   &lt 3 ENTER  &lt 2 BACKSPACE  &lt 4 DEL
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &none  &kp K_COPY  &kp K_PASTE  &kp BACKSPACE  &kp DEL  &none  &kp K_REDO  &kp K_PASTE  &kp K_COPY  &kp K_CUT  &none  &none
                &none  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  &none  &kp LEFT  &kp DOWN  &kp UP  &kp RIGHT  &none  &none
                &none  &none  &none  &none  &none  &none  &kp INS  &kp HOME  &kp PG_UP  &kp PG_DN  &kp END  &none
                          &trans  &trans  &trans   &trans  &trans  &trans
            >;
        };

        num {
            display-name = "NUM";
            bindings = <
                &none  &kp LEFT_BRACKET  &kp N7  &kp N8  &kp N9  &kp RIGHT_BRACKET  &none  &none  &none  &none  &none  &none
                &none  &kp SEMI  &kp N4  &kp N5  &kp N6  &kp EQUAL  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp GRAVE  &kp N1  &kp N2  &kp N3  &kp BACKSLASH  &none  &none  &none  &none  &none  &none
                          &trans  &kp N0  &kp MINUS   &trans  &trans  &trans
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &none  &kp LEFT_BRACE  &kp AMPS  &kp ASTRK  &kp LPAR  &kp RIGHT_BRACE  &none  &none  &none  &none  &bootloader  &none
                &none  &kp COLON  &kp DLLR  &kp PRCNT  &kp CARET  &kp PLUS  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &kp TILDE  &kp EXCL  &kp AT  &kp HASH  &kp PIPE  &none  &none  &none  &none  &none  &none
                          &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER   &trans  &trans  &trans
            >;
        };

        fun {
            display-name = "FUN";
            bindings = <
                &none  &none  &kp F7  &kp F8  &kp F9  &kp F10  &none  &none  &none  &none  &none  &none
                &none  &none  &kp F4  &kp F5  &kp F6  &kp F11  &none  &kp RSHFT  &kp RCTRL  &kp RALT  &kp RGUI  &none
                &none  &none  &kp F1  &kp F2  &kp F3  &kp F12  &none  &none  &none  &none  &none  &none
                          &trans  &trans  &trans   &trans  &trans  &trans
            >;
        };

        oth {
            display-name = "OTH";
            bindings = <
                &none  &bootloader  &bt BT_PRV  &bt BT_NXT  &none  &bt BT_CLR  &none  &kp C_BRI_DN  &kp C_BRI_UP  &none  &none  &none
                &none  &sys_reset  &bt BT_SEL 3  &bt BT_SEL 4  &none  &bt BT_CLR_ALL  &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &none  &none  &none
                &none  &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &none  &none  &none  &none  &none
                          &trans  &trans  &trans   &kp C_PP  &kp C_PREV  &kp C_NEXT
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                &trans &kp LGUI &kp LALT &kp LCTRL &kp LSHFT &trans           &trans &trans &trans &trans &trans &trans
                &trans &trans &trans &trans &trans &trans           &trans &trans &trans &trans &trans &trans
                            &mkp MCLK &mkp LCLK &mkp RCLK           &mkp LCLK &mkp RCLK &mkp MCLK
            >;
        };

        extra_2 {
                status = "reserved";
        };

        extra_3 {
                status = "reserved";
        };
    };
};
